# ABA PayWay sandbox (or production) credentials.
# Get these from your PayWay merchant dashboard.
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_API_KEY=

# Leave unset to default to the sandbox URL (checkout-sandbox.payway.com.kh).
# Switch to https://checkout.payway.com.kh only once you have a live account.
ABA_PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh

# Port this Express server listens on locally.
PORT=8787

# Public URL this server is reachable at — used to build PayWay's
# return_url/continue_success_url. For local dev this is fine as-is;
# in production set it to your deployed backend's real URL.
APP_URL=http://localhost:8787
